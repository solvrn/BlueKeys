<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.bluekeys">

    <!-- The only Bluetooth permission needed on Android 12+ to act as a keyboard
         ("Nearby devices" in the permission prompt). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Granted automatically at install (no prompt). Used only to check for updates. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.hardware.bluetooth" android:required="true" />

    <application
        android:label="BlueKeys"
        android:icon="@drawable/ic_bluekeys"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <!-- configChanges: rotating would otherwise rebuild the activity, which
                 shuts down the Bluetooth keyboard and drops the connection. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".TypingService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
